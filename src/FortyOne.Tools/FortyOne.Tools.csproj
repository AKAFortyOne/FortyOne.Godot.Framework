<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PackageId>FortyOne.Tools</PackageId>
        <Version>1.0.2</Version>
        <Authors>FortyOne</Authors>
        <Description>FortyOne Godot C# Framework: Tools (including EventSystem, InstanceRegistry, etc).</Description>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/AKAFortyOne/FortyOne.Godot.Framework</RepositoryUrl>
        
        <TargetFramework>net8.0</TargetFramework>
        <LangVersion>12.0</LangVersion>
        <Nullable>enable</Nullable>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="GodotSharp" Version="4.7.2" />
        <ProjectReference Include="../FortyOne.SourceGenerators/framework/SourceGenerator.Framework.csproj"
                          OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
        <ProjectReference Include="../FortyOne.SourceGenerators/game/SourceGenerator.Game.csproj"
                          ReferenceOutputAssembly="false" />
        <None Include="..\FortyOne.SourceGenerators/game/bin/$(Configuration)/netstandard2.0/SourceGenerator.Game.dll"
              Pack="true" PackagePath="analyzers/dotnet/cs/" />
    </ItemGroup>
</Project>
